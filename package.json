{
  "name": "backend",
  "version": "0.0.1",
  "type": "module",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docs:export": "nest build && node dist/export-openapi.js docs/openapi.json",
    "docs:build": "npm run docs:export && node scripts/build-static-docs.mjs",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma skills sync || exit 0",
    "dc": "docker compose -f docker-compose.yml -f docker-compose.dev.yml",
    "docker:dev": "npm run dc -- up --build",
    "docker:up": "npm run dc -- up",
    "docker:down": "npm run dc -- down",
    "docker:rebuild": "npm run dc -- up --build --renew-anon-volumes",
    "docker:logs": "npm run dc -- logs -f --tail=100",
    "docker:ps": "npm run dc -- ps",
    "docker:sh": "npm run dc -- exec backend sh",
    "db:migrate": "npm run dc -- run --rm migrate npx prisma migrate dev",
    "db:deploy": "npm run dc -- run --rm migrate npx prisma migrate deploy",
    "db:generate": "npm run dc -- exec backend npx prisma generate",
    "db:reset": "npm run dc -- run --rm migrate npx prisma migrate reset --force",
    "db:studio": "node scripts/db-studio.js",
    "db:psql": "npm run dc -- exec postgres psql -U cstam -d cstam",
    "db:seed": "npm run dc -- run --rm migrate npx prisma db seed",
    "redis:cli": "npm run dc -- exec redis redis-cli",
    "caddy:validate": "npm run dc -- exec reverse-proxy caddy validate --config /etc/caddy/Caddyfile",
    "caddy:reload": "npm run dc -- exec reverse-proxy caddy reload --config /etc/caddy/Caddyfile",
    "caddy:ca": "npm run dc -- cp reverse-proxy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt",
    "test:int": "npm run dc -- exec backend npx vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.0.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
