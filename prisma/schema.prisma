// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  GAMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum MachineEnrollmentStatus {
  PENDING
  ENROLLED
  INACTIVE
  DEACTIVATED
}

enum MachineStatus {
  ONLINE
  OFFLINE
}

enum TransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
  CREDIT
  DEBIT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

enum AlertCategory {
  HARDWARE
  ANTI_THEFT
  SECURITY_VIOLATION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommandType {
  LOCK
  UNLOCK
  SHUTDOWN
  LAUNCH_GAME
  END_SESSION
  CATALOG_UPDATE
}

// How the agent starts a catalog entry (GameLaunchTypes on the agent). The
// values are the wire strings.
enum GameLaunchType {
  exe
  steam
  epic
}

enum CommandStatus {
  PENDING
  SENT
  ACKED
  NACKED
  TIMEOUT
  FAILED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  AUTHENTICATE
}

// ============================================================================
// DATASOURCE & GENERATOR
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// ============================================================================
// MODELS
// ============================================================================

// --- Branch & Location ---

model Branch {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  location String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pricing           Pricing[]
  employeeProfiles  EmployeeProfile[]
  machines          Machine[]
  telemetryAlerts   TelemetryAlert[]
  commands          Command[]
  gameBranches      GameBranch[]
  enrollmentTokens  EnrollmentToken[]

  @@index([name])
  @@map("branches")
}

model Pricing {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  paygRate     Int      @map("payg_rate")
  bookingRate  Int      @map("booking_rate")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("pricing")
}

// --- User Management ---

model User {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(GAMER)
  accountStatus AccountStatus  @default(ACTIVE) @map("account_status")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  employeeProfile    EmployeeProfile?
  gamerProfile       GamerProfile?
  auditLogs          AuditLog[]
  acknowledgedAlerts TelemetryAlert[]
  refreshTokens      RefreshToken[]
  enrollmentTokens   EnrollmentToken[]

  @@index([username])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  jti            String    @unique
  userId         String    @map("user_id") @db.Uuid
  revoked        Boolean   @default(false)
  replacedByJti  String?   @map("replaced_by_jti")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmployeeProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  managedBranchId  String?          @map("managed_branch_id") @db.Uuid
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  hireDate         DateTime         @map("hire_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedBranch Branch?       @relation(fields: [managedBranchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([managedBranchId])
  @@index([employmentStatus])
  @@map("employee_profiles")
}

model GamerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  xp     Int    @default(0) 
  level  Int    @default(1) 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet?
  reservations  Reservation[]
  memberships   Membership[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("gamer_profiles")
}

// --- Wallet & Ledger ---
// Wallet.balance is a cached projection of SUM(LedgerEntry.amount)

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  gamerProfileId String   @unique @map("gamer_profile_id") @db.Uuid
  balance        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  gamerProfile GamerProfile  @relation(fields: [gamerProfileId], references: [id], onDelete: Cascade)
  entries      LedgerEntry[]

  @@index([gamerProfileId])
  @@map("wallets")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  sessionId      String?         @map("session_id") @db.Uuid
  amount         Int
  // history doesnt needto replay the ledger to date.
  balanceAfter   Int             @map("balance_after")
  type           TransactionType @default(PAYMENT)
  // Caller-supplied dedupe key
  // reposting same key is a no-op instead of double charge/credit.
  idempotencyKey String?         @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([walletId, idempotencyKey])
  @@index([walletId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@map("ledger_entries")
}

// --- Machines & Games ---

model Machine {
  id               String                  @id @default(uuid()) @db.Uuid
  serialNumber     String                  @unique @map("serial_number")
  branchId         String                  @map("branch_id") @db.Uuid
  agentPublicKey   String                  @map("agent_public_key")
  enrollmentStatus MachineEnrollmentStatus @default(PENDING) @map("enrollment_status")
  name             String?
  status           MachineStatus           @default(OFFLINE)
  lastSeen         DateTime?               @map("last_seen") @db.Timestamptz
  ipAddress        String?                 @map("ip_address")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  machineGames    MachineGame[]
  gameStatuses    StationGameStatus[]
  nodeTelemetry   NodeTelemetry[]
  telemetryAlerts TelemetryAlert[]
  reservations    Reservation[]
  commands         Command[]
  enrollmentTokens EnrollmentToken[]

  @@index([branchId])
  @@index([serialNumber])
  @@index([enrollmentStatus])
  @@index([status])
  @@map("machines")
}

// One-time enrollment credential. Only the SHA-256 of the token is stored.
// machineId null = fresh-station enrollment; set = credential rotation.
model EnrollmentToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  branchId   String    @map("branch_id") @db.Uuid
  machineId  String?   @map("machine_id") @db.Uuid
  issuedById String    @map("issued_by_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  machine  Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)
  issuedBy User     @relation(fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([machineId])
  @@index([expiresAt])
  @@map("enrollment_tokens")
}


// Backend-side game catalog. A station pulls its resolved view over
// GET /stations/me/games; LAUNCH_GAME then only carries `gameId`, and the agent
// launches it from its local copy of that catalog.
model Game {
  id               String         @id @default(uuid()) @db.Uuid
  // Stable wire id: what the catalog response and LAUNCH_GAME carry (1-128 chars).
  gameId           String         @unique @map("game_id")
  name             String
  launchType       GameLaunchType @default(exe) @map("launch_type")
  // exe: full .exe path | steam: app id | epic: AppName. Per-machine overrides live on MachineGame.
  target           String
  arguments        String?
  workingDirectory String?        @map("working_directory")
  // Image name of the game's own process (e.g. cs2.exe). Without it the agent
  // cannot track or close launcher-started (steam/epic) games.
  processName      String?        @map("process_name")
  iconUrl          String?        @map("icon_url")
  enabled          Boolean        @default(true)
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  machineGames MachineGame[]
  gameBranches GameBranch[]
  commands     Command[]

  @@index([enabled, sortOrder])
  @@map("games")
}

// Game offered at every station of a branch.
model GameBranch {
  gameId    String   @map("game_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([gameId, branchId])
  @@index([branchId])
  @@map("game_branches")
}

// Game assigned to one station, with optional per-machine overrides (a null
// override keeps the game's own value).
model MachineGame {
  machineId        String   @map("machine_id") @db.Uuid
  gameId           String   @map("game_id") @db.Uuid
  target           String?
  arguments        String?
  workingDirectory String?  @map("working_directory")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([machineId, gameId])
  @@index([machineId])
  @@index([gameId])
  @@map("machine_games")
}

// What the station's last `catalog_status` said: whether each catalog entry
// can actually be launched there. Replaced wholesale on every report.
// `gameId` is the wire id as the agent reported it (no FK: the agent may
// report an entry it rejected).
model StationGameStatus {
  machineId  String   @map("machine_id") @db.Uuid
  gameId     String   @map("game_id")
  installed  Boolean
  reason     String?
  reportedAt DateTime @map("reported_at") @db.Timestamptz

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([machineId, gameId])
  @@map("station_game_status")
}

// --- Telemetry ---

model NodeTelemetry {
  id         String   @id @default(uuid()) @db.Uuid
  machineId  String   @map("machine_id") @db.Uuid
  metrics    Json
  recordedAt DateTime @map("recorded_at") @db.Timestamptz

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([recordedAt])
  @@map("node_telemetry")
}

model TelemetryAlert {
  id                   String        @id @default(uuid()) @db.Uuid
  machineId            String        @map("machine_id") @db.Uuid
  branchId             String?       @map("branch_id") @db.Uuid
  category             AlertCategory
  type                 String
  value                Json?
  severity             AlertSeverity @default(MEDIUM)
  acknowledged         Boolean       @default(false)
  acknowledgedByUserId String?       @map("acknowledged_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  acknowledgedAt       DateTime?     @map("acknowledged_at") @db.Timestamptz

  machine            Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  branch             Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  acknowledgedByUser User?   @relation(fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@index([machineId])
  @@index([branchId])
  @@index([category])
  @@index([type])
  @@index([severity])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("telemetry_alerts")
}

// --- Station Commands ---

// One staff-issued control command. `id` doubles as the wire envelope id, so
// every resend of the same command carries the same id (agent idempotency).
// `issuedBy` has no FK on purpose: the history outlives the user row.
model Command {
  id            String        @id @db.Uuid
  machineId     String        @map("machine_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  type          CommandType
  status        CommandStatus @default(PENDING)
  issuedBy      String        @map("issued_by") @db.Uuid
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz
  nackCode      String?       @map("nack_code")
  nackReason    String?       @map("nack_reason")
  // Backend-side cause of FAILED/TIMEOUT (station gone, queue down, ...).
  failureReason String?       @map("failure_reason")
  attempts      Int           @default(0)
  // LAUNCH_GAME only: the catalog entry whose launchRef went on the wire.
  gameId        String?       @map("game_id") @db.Uuid

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  game    Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([machineId, status])
  @@index([machineId, issuedAt])
  @@index([branchId])
  @@map("commands")
}

// --- Reservations & Sessions ---

model Reservation {
  id             String           @id @default(uuid()) @db.Uuid
  gamerProfileId String           @map("gamer_profile_id") @db.Uuid
  machineId      String           @map("machine_id") @db.Uuid
  startTime      DateTime         @map("start_time") @db.Timestamptz
  endTime        DateTime         @map("end_time") @db.Timestamptz
  status         ReservationStatus @default(PENDING)
  // Play now (starts at once, walk-in rate) vs booked ahead (booking rate).
  isWalkIn       Boolean          @default(false) @map("is_walk_in")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  gamerProfile GamerProfile @relation(fields: [gamerProfileId], references: [id], onDelete: Cascade)
  machine      Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([gamerProfileId])
  @@index([machineId])
  @@index([status])
  @@index([startTime])
  @@index([createdAt])
  @@map("reservations")
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  reservationId       String        @map("reservation_id") @db.Uuid
  appliedMembershipId String?       @map("applied_membership_id") @db.Uuid
  startTime           DateTime      @map("start_time") @db.Timestamptz
  endTime             DateTime      @map("end_time") @db.Timestamptz
  status              SessionStatus @default(PENDING)
  // --- billing (feat/session-billing) ---
  lockedAt            DateTime?     @map("locked_at") @db.Timestamptz
  // Why the backend locked it ("runout" = out of funds: a top-up resumes it). Null otherwise.
  lockReason          String?       @map("lock_reason")
  meteringStartedAt   DateTime?     @map("metering_started_at") @db.Timestamptz
  meteredSeconds      Int           @default(0) @map("metered_seconds")
  rateCentsPerMinute  Int?          @map("rate_cents_per_minute")
  billingBreakdown    Json?         @map("billing_breakdown")
  settledAt           DateTime?     @map("settled_at") @db.Timestamptz
  // --- station login PIN: only the hash is stored; single-use, short-lived ---
  pinHash             String?       @map("pin_hash")
  pinExpiresAt        DateTime?     @map("pin_expires_at") @db.Timestamptz
  pinUsedAt           DateTime?     @map("pin_used_at") @db.Timestamptz
  pinAttempts         Int           @default(0) @map("pin_attempts")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  reservation       Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  appliedMembership Membership?  @relation(fields: [appliedMembershipId], references: [id], onDelete: SetNull)
  ledgerEntries     LedgerEntry[]

  @@index([reservationId])
  @@index([appliedMembershipId])
  @@index([status])
  @@index([startTime])
  @@map("sessions")
}


// --- Memberships & Plans ---

model MembershipPlan {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String  @unique
  price              Decimal @db.Decimal(10, 2)
  durationDays       Int     @map("duration_days")
  discountPercent    Decimal @map("discount_percent") @db.Decimal(5, 2)
  bookingAdvanceDays Int     @map("booking_advance_days") @default(7)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]

  @@index([name])
  @@map("membership_plans")
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  gamerProfileId   String           @map("gamer_profile_id") @db.Uuid
  membershipPlanId String           @map("membership_plan_id") @db.Uuid
  discountPercentSnapshot Decimal   @map("discount_percent_snapshot") @db.Decimal(5, 2)
  idempotencyKey   String?          @map("idempotency_key")
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  status           MembershipStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  gamerProfile   GamerProfile   @relation(fields: [gamerProfileId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  sessions       Session[]

  @@index([gamerProfileId])
  @@index([membershipPlanId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@unique([gamerProfileId, idempotencyKey])
  // ADR-004 §4: at most one ACTIVE membership per gamer
  @@unique([gamerProfileId], map: "memberships_one_active_per_gamer", where: raw("status = 'ACTIVE'"))
  @@map("memberships")
}

// --- Subscriptions & Plans ---

model SubscriptionPlan {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  price        Decimal @db.Decimal(10, 2)
  durationDays Int     @map("duration_days")
  benefits     Json    @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@index([name])
  @@map("subscription_plans")
}

model Subscription {
  id                 String           @id @default(uuid()) @db.Uuid
  gamerProfileId     String           @map("gamer_profile_id") @db.Uuid
  subscriptionPlanId String           @map("subscription_plan_id") @db.Uuid
  benefitsSnapshot  Json             @map("benefits_snapshot")
  idempotencyKey    String?          @map("idempotency_key")
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  gamerProfile     GamerProfile     @relation(fields: [gamerProfileId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  @@index([gamerProfileId])
  @@index([subscriptionPlanId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@unique([gamerProfileId, idempotencyKey])
  @@map("subscriptions")
}

// --- Audit & Logging ---

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    AuditAction
  target    String
  metadata  Json?       @default("{}")
  timestamp DateTime    @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([target])
  @@index([timestamp])
  @@map("audit_logs")
}
