# --- Postgres Credentials ---
POSTGRES_DB=cstam
POSTGRES_USER=cstam
POSTGRES_PASSWORD=change-me

# --- Database URL ---
DATABASE_URL="postgresql://cstam:change-me@postgres:5432/cstam?schema=public"

# --- Redis URL ---
REDIS_URL="redis://redis:6379"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="cstam-identity"

# --- Optional: sessions and bookings (defaults shown) ---
# BUSINESS_TIMEZONE="Africa/Tunis"
# SESSION_MIN_PLAY_MINUTES=5
# NO_SHOW_GRACE_MINUTES=30
# SESSION_PIN_MAX_ATTEMPTS=5
# SESSION_RUNOUT_MARGIN_S=30
# SESSION_RUNOUT_WARNING_LEAD_S=300
# SESSION_ENDING_NOTICE_MINUTES=10
# PIN_ENCRYPTION_KEY=""   # 16+ characters; default: derived from JWT_ACCESS_SECRET

# --- Optional: station timing, sent to every station (defaults shown) ---
# STATION_HEARTBEAT_INTERVAL_S=15   # PRESENCE_OFFLINE_AFTER_MS must be at least 3x this
# STATION_LEASE_S=60                # a lease is min(SESSION_LEASE_CAP_S, this)
# STATION_LEASE_GRACE_S=10          # the agent keeps a lapsed lease this long; a single drop bills at most lease + this

# --- Optional: station outages (defaults shown) ---
# OUTAGE_PEER_COUNT=2   # other stations of the branch dropping together = venue outage
# OUTAGE_WINDOW_S=60    # ...within this many seconds of each other

# --- Optional: rate limits of the public auth routes (defaults shown) ---
# RATE_LIMIT_LOGIN_FAILURES=10         # wrong passwords per IP + username, per 15 minutes
# RATE_LIMIT_REFRESHES_PER_MINUTE=60   # per IP
# RATE_LIMIT_SIGNUPS_PER_HOUR=30       # per IP

# --- Optional: uploaded images (badges, game images, avatars) ---
# UPLOAD_DIR="uploads"   # /app/uploads in Docker (the `uploads` volume)
