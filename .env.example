# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/cstam?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- JWT ---
# Use long, random, distinct secrets in every environment. Never reuse across envs.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="cstam-identity"

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12
