# --- Postgres Credentials ---
POSTGRES_DB=cstam
POSTGRES_USER=cstam
POSTGRES_PASSWORD=change-me

# --- Database URL ---
DATABASE_URL="postgresql://cstam:change-me@postgres:5432/cstam?schema=public"

# --- Redis URL ---
REDIS_URL="redis://redis:6379"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="cstam-identity"
